generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userEmail String
  files     File[]
  createdAt DateTime @default(now())
}

model File {
  id        String   @id @default(cuid())
  name      String
  content   String   @default("")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}