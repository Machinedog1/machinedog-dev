# Machinedog.dev — environment variable template
# Copy to .env and fill in real values. Do NOT commit .env.

# --- Database ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Auth: legacy session-based (still active) ---
ADMIN_EMAILS=admin@example.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Auth: Clerk (Phase 0 foundation, optional) ---
# When unset, the app falls back to demo/legacy auth and shows a banner.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Frontend (Vite) reads this to decide whether to mount ClerkProvider.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILD=
STRIPE_PRICE_PORTAL=
STRIPE_PRICE_RETAINER=
STRIPE_BUILD_DEPOSIT_USD=
STRIPE_PORTAL_USD=
STRIPE_RETAINER_USD=

# --- AI ---
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# --- Object storage ---
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Misc ---
PUBLIC_APP_URL=
LEADS_NOTIFY_EMAIL=
OPERATOR_EMAIL=
LOG_LEVEL=info
NODE_ENV=development
