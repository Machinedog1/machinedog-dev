# Machinedog.dev — environment variable template
#
# Copy to `.env` for local dev, or paste into Replit secrets in production.
# Variables are grouped by integration. Anything labelled REQUIRED must be set
# for that surface to work; optional vars have safe fallbacks (often a
# dev-only mock).
#
# DO NOT commit a real `.env`. Real secrets live in Replit's secrets pane or
# your hosting provider's secret manager.

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Postgres 16+ recommended.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── App ─────────────────────────────────────────────────────────────────────
# REQUIRED in production — used in webhook URLs and email links.
PUBLIC_APP_URL=
# Optional — operator inbox for compliance + billing notifications.
OPERATOR_EMAIL=
# Optional — where lead-form submissions are emailed.
LEADS_NOTIFY_EMAIL=
# Optional — pino log level (trace|debug|info|warn|error|fatal).
LOG_LEVEL=info
# Optional — set to "production" in deployed environments.
NODE_ENV=development
# REQUIRED in production. Comma-separated list of admin email addresses; the
# Clerk middleware promotes any matching member to role=admin on first login.
ADMIN_EMAILS=admin@example.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Clerk (auth) ────────────────────────────────────────────────────────────
# REQUIRED in production. Without these the portal runs in demo mode (banner
# visible, no real auth, no real org isolation).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# REQUIRED if you want organization webhooks (recommended).
CLERK_WEBHOOK_SECRET=
# REQUIRED for the portal to mount <ClerkProvider>. Mirror of the publishable
# key, exposed to the Vite build.
VITE_CLERK_PUBLISHABLE_KEY=

# ─── Stripe (payments) ───────────────────────────────────────────────────────
# REQUIRED in production. When unset (and BILLING_DEMO_MODE=true in dev) the
# api-server uses a mock checkout that grants plans / token packs immediately.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dev-only: set to "true" in non-production to enable the mock checkout flow.
# IGNORED in production — production boot refuses to start without
# STRIPE_SECRET_KEY.
BILLING_DEMO_MODE=

# Legacy build / portal / retainer offerings (the original consulting funnel).
STRIPE_PRICE_BUILD=
STRIPE_PRICE_PORTAL=
STRIPE_PRICE_RETAINER=
STRIPE_BUILD_DEPOSIT_USD=
STRIPE_PORTAL_USD=
STRIPE_RETAINER_USD=

# Phase 1 plan price IDs. See docs/setup-stripe.md.
STRIPE_PRICE_PLAN_STARTER_MONTHLY=
STRIPE_PRICE_PLAN_STARTER_ANNUAL=
STRIPE_PRICE_PLAN_PRO_MONTHLY=
STRIPE_PRICE_PLAN_PRO_ANNUAL=
STRIPE_PRICE_PLAN_BUSINESS_MONTHLY=
STRIPE_PRICE_PLAN_BUSINESS_ANNUAL=
STRIPE_PRICE_PLAN_HEALTHCARE_MONTHLY=
STRIPE_PRICE_PLAN_HEALTHCARE_ANNUAL=
STRIPE_PRICE_PLAN_ENTERPRISE_MONTHLY=
STRIPE_PRICE_PLAN_ENTERPRISE_ANNUAL=

# Phase 1 token pack one-off price IDs. If unset, checkout falls back to
# inline price_data with the amounts in lib/plans.ts.
STRIPE_PRICE_PACK_SMALL=
STRIPE_PRICE_PACK_MEDIUM=
STRIPE_PRICE_PACK_LARGE=

# ─── AI providers ────────────────────────────────────────────────────────────
# Routed through Replit's AI Integrations proxy. Set whichever providers you
# want exposed. The MVP uses Anthropic by default.
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Optional in MVP. Personal access token used for public-repo cloning when a
# user picks "Import from GitHub" during onboarding. Production should move to
# a real GitHub App — see PHASE_2_MIGRATION_PLAN.md.
GITHUB_TOKEN=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Optional. Used by the leads + invite email senders. The Replit Resend
# integration is the recommended path; set these only if you self-host SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# ─── Object storage ──────────────────────────────────────────────────────────
# Required if you exercise file uploads. Defaults are wired for Replit's
# built-in object storage in dev.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ─── AWS (Phase 3 — placeholders only) ───────────────────────────────────────
# These are NOT used by the MVP. They are documented so the AWS HIPAA phase
# has a clear contract to fill in. See AWS_HIPAA_PHASE_3_PLAN.md.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=
AWS_SECRETS_MANAGER_PREFIX=
